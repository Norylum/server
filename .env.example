# Generated by scripts/norylum-docker.sh setup
NORYLUM_ADMIN_USERNAME=admin
NORYLUM_UID=1000
NORYLUM_GID=1000
NORYLUM_PORT=8120
NORYLUM_INGEST_POLL_SECONDS=15
NORYLUM_RUST_LOG=info,norylum=debug

# BitTorrent: authorizations live in SQLite; network binding is local by default.
# Localhost by default; public binding requires explicit configuration.
NORYLUM_TORRENT_BIND_IP=127.0.0.1
NORYLUM_TORRENT_PORT=6881
