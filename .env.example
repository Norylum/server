# Generated by scripts/norylum-docker.sh setup
NORYLUM_ADMIN_USERNAME=admin
NORYLUM_UID=1000
NORYLUM_GID=1000
NORYLUM_PORT=8120
NORYLUM_INGEST_POLL_SECONDS=15
NORYLUM_RUST_LOG=info,norylum=debug

# BitTorrent: authorizations live in SQLite; network binding is local by default.
# Localhost by default; public binding requires explicit configuration.
NORYLUM_TORRENT_BIND_IP=127.0.0.1
NORYLUM_TORRENT_PORT=6881

# Acquisition and seeding VPN, configurable per installation.
# Supported: protonvpn, mullvad, airvpn, nordvpn,
# or "private internet access".
NORYLUM_VPN_PROVIDER=protonvpn
NORYLUM_VPN_TYPE=wireguard
NORYLUM_VPN_COUNTRIES=

# Secrets are local files in vpn-secrets/, never in .env.
# No incoming torrent port is published by default.

# Optional VPN server-region filter; notably used by PIA.
NORYLUM_VPN_REGIONS=

# PIA example:
# NORYLUM_VPN_PROVIDER="private internet access"
# NORYLUM_VPN_TYPE=openvpn

# Optional Prowlarr integration (acquisition auto-search).
NORYLUM_PROWLARR_URL=
NORYLUM_PROWLARR_KEY=

# Optional webhook fired when an acquisition completes successfully.
# POST { "event": "acquisition_completed", "request_id": "..." }
NORYLUM_WEBHOOK_URL=

# Optional HTTPS reverse proxy domain (Caddy auto-TLS).
# Set to your public domain name when using the `proxy` Docker profile.
NORYLUM_DOMAIN=
